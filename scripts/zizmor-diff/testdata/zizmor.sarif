{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": { "driver": { "name": "zizmor", "version": "1.30.1" } },
      "results": [
        {
          "ruleId": "zizmor/template-injection",
          "message": { "text": "code injection via template expansion" },
          "locations": [
            {
              "logicalLocations": [{ "properties": { "symbolic": { "key": { "Local": { "verbatim_path": "./.github/workflows/ci.yml" } } } } }],
              "physicalLocation": {
                "artifactLocation": { "uri": "sub/.github/workflows/ci.yml" },
                "region": { "startLine": 12 }
              }
            }
          ]
        },
        {
          "ruleId": "zizmor/excessive-permissions",
          "message": { "text": "overly broad permissions" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": ".github/workflows/ci.yml" },
                "region": { "startLine": 8 }
              }
            }
          ]
        },
        {
          "ruleId": "zizmor/excessive-permissions",
          "message": { "text": "overly broad permissions" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": ".github/workflows/other.yml" },
                "region": { "startLine": 3 }
              }
            }
          ]
        },
        {
          "ruleId": "zizmor/future-audit",
          "message": { "text": "workflow or action definition without a name" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": ".github/workflows/ci.yml" },
                "region": { "startLine": 1 }
              }
            }
          ]
        },
        {
          "ruleId": "zizmor/artipacked",
          "message": { "text": "credential persistence through GitHub Actions artifacts" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "action.yml" },
                "region": { "startLine": 4 }
              }
            }
          ]
        }
      ]
    }
  ]
}
